# ===== انسخ الملف ده باسم .env وعبّي القيم =====
PORT=5000

# Atlas: خد الرابط من Atlas ← Connect ← Drivers (غيّر <user> و <password> واسم الداتابيز cinema)
# أو MongoDB على جهازك: mongodb://127.0.0.1:27017/cinema
MONGODB_URI=mongodb+srv://hh5444401_db_user:20T9MEHSFkevaLTN@<cluster>.mongodb.net/cinema?retryWrites=true&w=majority

# كلمة سر طويلة عشوائية لتوقيع الـ JWT (غيّرها!)
JWT_SECRET=change-this-to-a-long-random-string

# أماكن تشغيل الموقع (Live Server). localhost و 127.0.0.1 بأي بورت مسموحين تلقائيًا
CLIENT_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# حساب الأدمن اللي بيتعمل في seed
